# FalconBeat — no-S3 layout (recommended): audio lives on this host,
# pushed by the FPP plugin through the ingest service.

# Admin auth: plugin/bridge connects to BeatSync with ?creator=$CREATOR_SECRET
# (guaranteed admin regardless of join order). LAN-side only.
CREATOR_SECRET=change-me-long-random-string

# Bearer token for PUTs to the ingest service (also LAN-side only).
INGEST_TOKEN=change-me-long-random-string

# ── Alternative: S3-backed upload path (Cloudflare R2 / MinIO) ───────
# Only needed if you want BeatSync's built-in presigned-upload flow.
# S3_BUCKET_NAME=falconbeat
# S3_PUBLIC_URL=https://audio.falconbeat.example.com
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Alternative: demo mode (static playlist, no runtime pushes) ──────
# DEMO=1  DEMO_AUDIO_DIR=/media  DEMO_ADMIN_SECRET=change-me

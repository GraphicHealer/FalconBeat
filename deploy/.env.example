# FalconBeat — no-S3 layout: audio lives on this host, pushed by the FPP
# plugin through the single edge port.

# The one shared secret. Used for:
#   - plugin admin WebSocket auth (?creator=)
#   - Bearer token on ingest PUTs (/media/*, /config/*)
#   - Bearer gate on POST /upload/complete
# Paste the same value into the plugin's Token field.
FALCONBEAT_TOKEN=change-me-long-random-string

# ── Legacy overrides (usually not needed) ────────────────────────────
# Split deployments can still set these individually; each overrides the
# shared token for its own gate.
# INGEST_TOKEN=      # ingest Bearer only
# CREATOR_SECRET=    # BeatSync ?creator= admin auth only
# (set FALCONBEAT_TOKEN anyway — it also gates /upload/complete)

# ── Alternative: S3-backed upload path (Cloudflare R2 / MinIO) ───────
# Only needed if you want BeatSync's built-in presigned-upload flow.
# S3_BUCKET_NAME=falconbeat
# S3_PUBLIC_URL=https://audio.falconbeat.example.com
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Alternative: demo mode (static playlist, no runtime pushes) ──────
# DEMO=1  DEMO_AUDIO_DIR=/media  DEMO_ADMIN_SECRET=change-me

# Non-demo mode (required for runtime audio pushes from the FPP plugin)

# Admin auth: plugin/bridge connects with ?creator=$CREATOR_SECRET (guaranteed
# admin regardless of join order). Visitors never see it — keep it LAN-side.
CREATOR_SECRET=change-me-long-random-string

# S3-compatible object storage. Cloudflare R2 recommended: free tier, zero
# egress fees, public bucket URL for phone downloads, presigned PUT works
# outbound from the Pi. MinIO on this LAN also works but needs a second
# cloudflared hostname so phones can GET audio over the internet.
S3_BUCKET_NAME=falconbeat
S3_PUBLIC_URL=https://audio.falconbeat.example.com   # public GET base
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Demo mode alternative (no S3, static playlist staged before boot) ──
# DEMO=1
# DEMO_AUDIO_DIR=/audio
# DEMO_ADMIN_SECRET=change-me

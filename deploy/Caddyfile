# FalconBeat edge: static SPA + media + proxy to BeatSync on one origin.
# The listener page resolves ws(s)://{host}/ws same-origin — no CORS, no
# NEXT_PUBLIC_* env. Audio URLs registered with BeatSync are absolute
# (https://{host}/media/...) so phones fetch them straight from Caddy —
# the BeatSync server never touches audio bytes.

:80 {
	encode gzip

	# BeatSync WebSocket (reverse_proxy handles the Upgrade)
	# Upstream is env-overridable: localhost in the all-in-one image,
	# beatsync:8080 if the services are ever split across containers.
	handle /ws* {
		reverse_proxy {$BEATSYNC_UPSTREAM:localhost:8080}
	}

	# Harmless introspection endpoints
	handle /health* {
		reverse_proxy {$BEATSYNC_UPSTREAM:localhost:8080}
	}

	# Show audio pushed by the FPP plugin via the ingest service (LAN-only),
	# served to phones straight from disk. Audio is immutable per show —
	# cache hard. show.json/nowplaying.json change constantly — no-cache.
	handle /media/* {
		root * /media
		uri strip_prefix /media
		@json path *.json
		header @json Cache-Control "no-cache, must-revalidate"
		@audio not path *.json
		header @audio Cache-Control "public, max-age=3600, immutable"
		file_server
	}

	# Everything else → the Vite SPA
	handle {
		root * /srv/falconbeat
		try_files {path} /index.html
		file_server
	}
}

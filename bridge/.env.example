# FalconBeat bridge — non-demo mode (the live configuration).
# Push flow: PUT file to ingest → POST /upload/complete → play <publicUrl>.
# Everything goes through the one published port (default 8000) — Caddy
# routes /ws, /upload/complete, and ingest PUTs to the right process.

# FalconBeat server URL (WS + HTTP share it — http/https both accepted).
BEATSYNC_URL=ws://localhost:8000
INGEST_URL=http://localhost:8000

# The one shared secret — matches FALCONBEAT_TOKEN on the server.
# Admin WS (?creator=), ingest Bearer, and /upload/complete all use it.
# (Set both names — the bridge reads them separately.)
CREATOR_SECRET=change-me-long-random-string
INGEST_TOKEN=change-me-long-random-string

# Room ID — arbitrary in non-demo mode; created on first join. Keep consistent.
ROOM_ID=000000

# Base devices fetch audio from — relative "/media" resolves same-origin on
# whatever URL the listener page loaded, so it works LAN and public alike.
MEDIA_PUBLIC_URL=/media

# ── Optional S3 path (upload cmd) ────────────────────────────────────
# Only needed if the server runs with S3_* (R2/MinIO). push doesn't use it.

# ── Demo mode fallback ───────────────────────────────────────────────
# ADMIN_SECRET=...   # server runs DEMO=1; static playlist in DEMO_AUDIO_DIR

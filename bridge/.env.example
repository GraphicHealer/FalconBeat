# FalconBeat bridge — non-demo mode (the live configuration).
# Server runs without DEMO; admin auth is ?creator=$CREATOR_SECRET.
# Push flow: PUT file to ingest → POST /upload/complete → play <publicUrl>.

# BeatSync WebSocket server (LAN address of the FalconBeat host).
BEATSYNC_URL=ws://localhost:8080

# Admin secret — matches CREATOR_SECRET on the server.
# ?creator= is always admin regardless of join order. Keep on LAN.
CREATOR_SECRET=change-me-long-random-string

# Room ID — arbitrary in non-demo mode; created on first join. Keep consistent.
ROOM_ID=000000

# ── Media pipeline (S3-free path) ────────────────────────────────────
# Ingest service (LAN-only, receives PUTs and writes the media dir).
INGEST_URL=http://localhost:8090
INGEST_TOKEN=change-me-long-random-string
# Public base phones fetch audio from — through cloudflared → Caddy /media/*.
MEDIA_PUBLIC_URL=https://falconbeat.example.com/media

# ── Optional S3 path (upload cmd) ────────────────────────────────────
# Only needed if the server runs with S3_* (R2/MinIO). push doesn't use it.

# ── Demo mode fallback ───────────────────────────────────────────────
# ADMIN_SECRET=...   # server runs DEMO=1; static playlist in DEMO_AUDIO_DIR
